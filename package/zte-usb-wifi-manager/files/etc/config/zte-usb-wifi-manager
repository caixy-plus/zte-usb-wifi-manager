config core 'main'
	option enabled '1'
	option write_enabled '0'
	option poll_interval '30'
	option failure_threshold '3'

config actions 'writes'
	option sim_switch_enabled '0'
	option cellular_write_enabled '0'
	option wifi_write_enabled '0'
	option traffic_write_enabled '0'
	option sms_write_enabled '0'
	option device_reboot_enabled '0'
	option device_shutdown_enabled '0'
	option power_supply_write_enabled '0'

config device 'zte'
	option host '192.168.0.1'
	option interface 'usbwan'
	option netdev 'eth2'
	option adapter 'auto'
	option credential_file '/etc/zte-usb-wifi-manager/credentials'

# U30 Pro device-side charging policy. This changes only the modem's
# power_supply_mode; it never disables USB VBUS or the USB data connection.
config smart_charge 'charging'
	option enabled '0'
	option low_percent '30'
	option high_percent '80'
	option retry_seconds '300'

# USB control is retained only for fail-safe restoration and a future,
# separately confirmed recovery action. It is never battery-policy driven.
config power 'usb'
	option backend 'unconfigured'
	option control_path 'auto'
	option calibrated '0'
	option off_probe_interval '900'
	option probe_settle_seconds '15'
