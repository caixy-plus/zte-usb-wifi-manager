config core 'main'
	option enabled '1'
	option write_enabled '1'
	option access_profile 'charge_v1'
	option poll_interval '30'
	option failure_threshold '3'

# Only the daemon-driven smart-charge write remains. It is not exposed as a
# manual LuCI action; the gate still protects set_power_supply_mode execution.
config actions 'writes'
	option set_power_supply_mode_enabled '1'

config device 'zte'
	option host '192.168.0.1'
	option interface 'usbwan'
	option netdev 'eth2'
	option adapter 'auto'
	option credential_file '/etc/zte-usb-wifi-manager/credentials'

# U30 Pro device-side charging policy. This changes only the modem's
# power_supply_mode; it never disables USB VBUS or the USB data connection.
config smart_charge 'charging'
	option enabled '1'
	option low_percent '30'
	option high_percent '80'
	option retry_seconds '300'
