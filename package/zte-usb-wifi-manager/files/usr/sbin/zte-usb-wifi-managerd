#!/bin/sh
set -e

. /lib/functions.sh
. /usr/lib/zte-usb-wifi-manager/validation.sh
. /usr/lib/zte-usb-wifi-manager/json.sh
. /usr/lib/zte-usb-wifi-manager/http.sh
. /usr/lib/zte-usb-wifi-manager/credentials.sh
. /usr/lib/zte-usb-wifi-manager/session.sh
. /usr/lib/zte-usb-wifi-manager/smart-charge-policy.sh
. /usr/lib/zte-usb-wifi-manager/smart-charge-state.sh
. /usr/lib/zte-usb-wifi-manager/event-log.sh
. /usr/lib/zte-usb-wifi-manager/charging-transaction.sh
. /usr/lib/zte-usb-wifi-manager/actions.sh
. /usr/lib/zte-usb-wifi-manager/action-executor.sh
. /usr/lib/zte-usb-wifi-manager/snapshot.sh
. /usr/lib/zte-usb-wifi-manager/netifd-adapter.sh
. /usr/lib/zte-usb-wifi-manager/device-profile.sh
. /usr/lib/zte-usb-wifi-manager/adapter-zte-u25s-metadata.sh
. /usr/lib/zte-usb-wifi-manager/adapter-zte-u25s.sh

STATE_DIR=/var/run/zte-usb-wifi-manager
STATUS_FILE=$STATE_DIR/status.json
COOKIE_FILE=$STATE_DIR/cookies.txt
PID_FILE=$STATE_DIR/manager.pid
EVENT_LOG_MAX_BYTES=524288
SMART_CHARGE_RETRY_SECONDS=300

load_config() {
	# config_get assigns these global variables by the name in its first argument.
	enabled=''
	write_enabled=''
	set_power_supply_mode_enabled=''
	poll_interval=''
	failure_threshold=''
	host=''
	adapter=''
	interface=''
	netdev=''
	credential_file=''
	battery_enabled=''
	battery_low=''
	battery_high=''
	smart_charge_retry_seconds=''

	config_load zte-usb-wifi-manager
	config_get enabled main enabled 1
	config_get write_enabled main write_enabled 0
	config_get set_power_supply_mode_enabled writes set_power_supply_mode_enabled 0
	config_get poll_interval main poll_interval 30
	config_get failure_threshold main failure_threshold 3
	config_get host zte host 192.168.0.1
	config_get adapter zte adapter auto
	config_get interface zte interface usbwan
	config_get netdev zte netdev eth2
	config_get credential_file zte credential_file \
		/etc/zte-usb-wifi-manager/credentials
	config_get battery_enabled charging enabled 0
	config_get battery_low charging low_percent 30
	config_get battery_high charging high_percent 80
	config_get smart_charge_retry_seconds charging retry_seconds 300

	zte_validate_host "$host" || {
		logger -t zte-usb-wifi-manager 'invalid device host'
		return 1
	}
	zte_validate_interface "$interface" || {
		logger -t zte-usb-wifi-manager 'invalid network interface name'
		return 1
	}
	zte_validate_netdev "$netdev" || {
		logger -t zte-usb-wifi-manager 'invalid network device name'
		return 1
	}
	ZTE_HTTP_INTERFACE=$netdev
	export ZTE_HTTP_INTERFACE
	if ! zte_is_uint "$failure_threshold" ||
		[ "$failure_threshold" -lt 1 ]; then
		logger -t zte-usb-wifi-manager 'invalid failure threshold'
		return 1
	fi
	if ! zte_is_uint "$poll_interval" ||
		[ "$poll_interval" -lt 10 ] ||
		[ "$poll_interval" -gt 3600 ]; then
		logger -t zte-usb-wifi-manager 'invalid poll interval'
		return 1
	fi
	zte_validate_thresholds "$battery_low" "$battery_high" || {
		logger -t zte-usb-wifi-manager 'invalid battery thresholds'
		return 1
	}
	if ! zte_is_uint "$smart_charge_retry_seconds" ||
		[ "$smart_charge_retry_seconds" -lt 30 ] ||
		[ "$smart_charge_retry_seconds" -gt 3600 ]; then
		logger -t zte-usb-wifi-manager 'invalid smart-charge retry interval'
		return 1
	fi
	SMART_CHARGE_RETRY_SECONDS=$smart_charge_retry_seconds
	case $enabled:$write_enabled:$set_power_supply_mode_enabled:$battery_enabled in
		[01]:[01]:[01]:[01]) ;;
		*)
			logger -t zte-usb-wifi-manager 'invalid policy flags'
			return 1
			;;
	esac
}

device_profile_still_valid() {
	zte_device_profile_detect_netdev \
		"${ZTE_SYS_CLASS_NET_ROOT:-/sys/class/net}" "$netdev" || return 1
	[ "${ZTE_DEVICE_PROFILE_ID:-}" = zte_u30 ]
}

configure_device_profile() {
	# Product target is U30 Pro only. Configuration may constrain the accepted
	# profile, but it never substitutes for the USB identity bound to netdev.
	case $adapter in
		auto|zte_u30|'') device_profile_still_valid || return 1 ;;
		*)
			logger -t zte-usb-wifi-manager \
				'only zte_u30 is supported in the smart-charge product'
			return 1
			;;
	esac
	zte_adapter_apply_profile || return 1
	ZTE_DEVICE_ORIGIN=$(printf '%s://%s' \
		"$ZTE_DEVICE_PROFILE_SCHEME" "$host")
	zte_http_origin_valid "$ZTE_DEVICE_ORIGIN" || return 1
	ZTE_DEVICE_TLS_INSECURE=$ZTE_DEVICE_PROFILE_TLS_INSECURE
	ZTE_LOGIN_REQUIRED=$ZTE_DEVICE_PROFILE_LOGIN_REQUIRED
	export ZTE_DEVICE_ORIGIN ZTE_DEVICE_TLS_INSECURE ZTE_LOGIN_REQUIRED
}

configured_action_enabled() {
	[ "${1-}" = set_power_supply_mode ] || return 1
	zte_adapter_action_effectively_enabled \
		set_power_supply_mode "$write_enabled" \
		"$set_power_supply_mode_enabled"
}

init_state() {
	umask 077
	mkdir -p "$STATE_DIR"
	chmod 700 "$STATE_DIR"
	zte_event_init "$STATE_DIR"
}

write_pid_file() {
	_zte_pid_dir=${PID_FILE%/*}
	_zte_pid_tmp=$PID_FILE.tmp.$$
	umask 077
	mkdir -p "$_zte_pid_dir" || return 1
	printf '%s\n' "$$" >"$_zte_pid_tmp" || return 1
	chmod 600 "$_zte_pid_tmp" || return 1
	mv "$_zte_pid_tmp" "$PID_FILE"
}

remove_pid_file() {
	[ -s "${PID_FILE:-}" ] || return 0
	_zte_pid_owner=$(cat "$PID_FILE" 2>/dev/null) || return 0
	[ "$_zte_pid_owner" = "$$" ] || return 0
	rm -f "$PID_FILE"
}

reset_device_session() {
	rm -f "$COOKIE_FILE" 2>/dev/null || return 1
	[ ! -e "$COOKIE_FILE" ] && [ ! -L "$COOKIE_FILE" ]
}

write_status() {
	umask 077
	mkdir -p "$STATE_DIR"
	_zte_status_tmp=$STATUS_FILE.tmp.$$
	printf '%s\n' "$1" >"$_zte_status_tmp"
	chmod 600 "$_zte_status_tmp"
	mv "$_zte_status_tmp" "$STATUS_FILE"
}

publish_unsupported_device() {
	_zte_profile_updated=$(date +%s)
	_zte_profile_status=$(zte_snapshot_compose \
		unsupported_device unsupported_device '' '' unavailable none 0 \
		"$_zte_profile_updated" '' 'Unknown ZTE')
	write_status "$_zte_profile_status"
}

collect_network() {
	if command -v ubus >/dev/null 2>&1 &&
		command -v jsonfilter >/dev/null 2>&1; then
		network_json=$(zte_netifd_collect "$interface" "$netdev")
	else
		network_json=$(zte_netifd_json 0 "$netdev" '' '' 0)
	fi
}

collect_power_snapshot() {
	# USB VBUS control is outside the product, so no hardware-power block is
	# published in the status snapshot.
	power_json=''
}

shutdown_manager() {
	[ "${shutdown_started:-0}" = 0 ] || return 0
	shutdown_started=1
	trap - 0 1 2 15
	remove_pid_file
}

record_event() {
	_zte_event_level=$1
	_zte_event_type=$2
	_zte_event_code=$3
	_zte_event_time=$4
	zte_event_write \
		"$STATE_DIR" "$_zte_event_level" "$_zte_event_type" \
		"$_zte_event_code" "$_zte_event_time" "$EVENT_LOG_MAX_BYTES"
}

# rpcd leaves a durable UCI marker until a successful service reload has made
# the committed values active. Daemon startup can prove that fact from the
# values it just loaded and finalize the marker without recursively reloading
# itself. Any ambiguity disables automatic charging writes for this process.
recover_charging_transaction() {
	_zte_charging_tx_result=$(zte_charging_transaction_daemon_finalize \
		"$STATE_DIR" "$battery_enabled" "$battery_low" "$battery_high") ||
		_zte_charging_tx_result=transaction_recovery_failed
	[ "$_zte_charging_tx_result" = ok ] && return 0
	battery_enabled=0
	logger -t zte-usb-wifi-manager \
		'charging_transaction_recovery_failed; automatic charging disabled'
	record_event error smart_charge charging_transaction_recovery_failed \
		"$(date +%s)" || :
	return 0
}

record_state_change() {
	_zte_new_state=$1
	_zte_state_time=$2
	[ "$_zte_new_state" != "$last_logged_state" ] || return 0

	case $_zte_new_state in
		ok) _zte_state_level=info ;;
		degraded|credentials_missing|authentication_failed) _zte_state_level=warn ;;
		fail_safe) _zte_state_level=error ;;
		*) return 0 ;;
	esac
	if record_event \
		"$_zte_state_level" state "state_$_zte_new_state" \
		"$_zte_state_time"; then
		last_logged_state=$_zte_new_state
	fi
}

# Evaluate and, when every server-side gate is open, apply U30 Pro's
# device-side power-supply mode. This function never calls the legacy USB
# power adapter. A failed or ambiguous POST is cooled down before another
# fresh snapshot can cause a new attempt.
apply_smart_charge_policy() {
	policy_state=STATE_UNKNOWN
	power_action=keep

	if [ "${ZTE_ADAPTER_ID:-}" != zte_u30 ]; then
		policy_state=UNSUPPORTED_DEVICE
		return 0
	fi
	_zte_smart_battery=$(zte_json_path_get \
		"$device_json" battery percent 2>/dev/null) || _zte_smart_battery=''
	_zte_smart_raw_mode=$(zte_json_path_get \
		"$device_json" power_supply mode_raw 2>/dev/null) || _zte_smart_raw_mode=''
	case $_zte_smart_raw_mode in
		0) _zte_smart_current=charging ;;
		1) _zte_smart_current=direct_supply ;;
		*) _zte_smart_current=unknown ;;
	esac
	_zte_smart_result=$(zte_smart_charge_decide \
		"$battery_enabled" "$_zte_smart_battery" "$battery_low" \
		"$battery_high" "$_zte_smart_current") || {
		policy_state=STATE_UNKNOWN
		return 0
	}
	policy_state=${_zte_smart_result%%:*}
	_zte_smart_decision=${_zte_smart_result#*:}
	case $_zte_smart_decision in
		KEEP) return 0 ;;
		CHARGE) _zte_smart_target=charging ;;
		DIRECT_SUPPLY) _zte_smart_target=direct_supply ;;
		*) policy_state=STATE_UNKNOWN; return 0 ;;
	esac
	if [ "${smart_charge_persistence_failed:-0}" = 1 ]; then
		policy_state=COOLDOWN_PERSIST_FAILED
		return 0
	fi
	_zte_smart_now=$(date +%s)
	if [ "${smart_charge_retry_after:-0}" != 0 ] ||
		[ -n "${smart_charge_last_error:-}" ]; then
		_zte_smart_intent_target=''
		case ${smart_charge_last_error:-} in
			attempt_charging) _zte_smart_intent_target=charging ;;
			attempt_direct_supply)
				_zte_smart_intent_target=direct_supply
				;;
		esac
		if [ -n "$_zte_smart_intent_target" ] &&
			[ "$_zte_smart_intent_target" = "$_zte_smart_current" ]; then
			if zte_smart_charge_cooldown_clear "$STATE_DIR"; then
				smart_charge_retry_after=0
				smart_charge_last_error=''
			else
				smart_charge_persistence_failed=1
				policy_state=COOLDOWN_PERSIST_FAILED
				record_event error smart_charge \
					smart_charge_persistence_failed "$_zte_smart_now" || :
			fi
			return 0
		fi
		if zte_is_uint "${smart_charge_retry_after:-0}" &&
			[ "${smart_charge_retry_after:-0}" -gt "$_zte_smart_now" ]; then
			policy_state=COOLDOWN
			return 0
		fi
		if ! zte_smart_charge_cooldown_clear "$STATE_DIR"; then
			smart_charge_persistence_failed=1
			policy_state=COOLDOWN_PERSIST_FAILED
			record_event error smart_charge \
				smart_charge_persistence_failed "$_zte_smart_now" || :
			return 0
		fi
		smart_charge_retry_after=0
		smart_charge_last_error=''
	fi
	if [ "$_zte_smart_target" = "$_zte_smart_current" ]; then
		return 0
	fi
	# The interface may have been unplugged or replaced after this poll's read.
	# Revalidate its exact USB owner immediately before any device write. Clear
	# the candidate identity too, so rpcd cannot advertise capabilities from a
	# snapshot that is already known to be stale.
	if ! device_profile_still_valid; then
		device_identity_invalid=1
		device_json=''
		policy_state=UNSUPPORTED_DEVICE
		return 0
	fi
	if ! zte_adapter_action_supported set_power_supply_mode; then
		policy_state=AWAITING_CALIBRATION
		return 0
	fi
	if ! configured_action_enabled set_power_supply_mode; then
		policy_state=WRITE_DISABLED
		return 0
	fi
	if ! zte_device_action_claim "$STATE_DIR"; then
		policy_state=ACTION_BUSY
		return 0
	fi
	smart_charge_retry_after=$((_zte_smart_now + SMART_CHARGE_RETRY_SECONDS))
	smart_charge_last_error=attempt_$_zte_smart_target
	if ! zte_smart_charge_cooldown_write "$STATE_DIR" \
		"$smart_charge_retry_after" "$smart_charge_last_error"; then
		smart_charge_persistence_failed=1
		policy_state=COOLDOWN_PERSIST_FAILED
		zte_device_action_release "$STATE_DIR" || :
		logger -t zte-usb-wifi-manager \
			'smart-charge intent persist failed before device write'
		record_event error smart_charge \
			smart_charge_persistence_failed "$_zte_smart_now" || :
		return 0
	fi
	_zte_smart_password=''
	if _zte_smart_saved_password=$(zte_read_password \
		"$credential_file" 2>/dev/null); then
		_zte_smart_password=$_zte_smart_saved_password
	fi
	_zte_smart_saved_password=''
	_zte_smart_execute_result=''
	if _zte_smart_execute_result=$(zte_execute_power_supply_mode \
		"$host" "$_zte_smart_password" "$COOKIE_FILE" \
		"$_zte_smart_target"); then
		_zte_smart_password=''
		power_action=$_zte_smart_target
		if zte_smart_charge_cooldown_clear "$STATE_DIR"; then
			smart_charge_retry_after=0
			smart_charge_last_error=''
			record_event info smart_charge smart_charge_applied \
				"$_zte_smart_now" || :
		else
			smart_charge_persistence_failed=1
			policy_state=COOLDOWN_PERSIST_FAILED
			logger -t zte-usb-wifi-manager \
				'smart-charge intent clear failed after device write'
			record_event error smart_charge \
				smart_charge_persistence_failed "$_zte_smart_now" || :
		fi
		zte_device_action_release "$STATE_DIR" || :
		return 0
	fi
	_zte_smart_password=''
	if zte_smart_charge_error_valid "$_zte_smart_execute_result"; then
		smart_charge_last_error=$_zte_smart_execute_result
	else
		smart_charge_last_error=executor_failed
	fi
	if zte_smart_charge_cooldown_write "$STATE_DIR" \
		"$smart_charge_retry_after" "$smart_charge_last_error"; then
		policy_state=WRITE_FAILED
	else
		smart_charge_persistence_failed=1
		policy_state=COOLDOWN_PERSIST_FAILED
		record_event error smart_charge \
			smart_charge_persistence_failed "$_zte_smart_now" || :
	fi
	zte_device_action_release "$STATE_DIR" || :
	power_action=keep
	logger -t zte-usb-wifi-manager \
		"smart-charge write failed: $smart_charge_last_error"
	record_event error smart_charge smart_charge_failed "$_zte_smart_now" || :
	return 0
}

# Apply an atomically replaced or removed credential on the next poll. The
# revision contains file metadata only; password content never leaves the
# credential reader.
refresh_credential_revision() {
	_zte_current_credential_revision=$(
		zte_credential_revision "$credential_file" 2>/dev/null
	) || _zte_current_credential_revision=invalid
	if [ "$_zte_current_credential_revision" = "$credential_revision" ]; then
		return 0
	fi
	rm -f "$COOKIE_FILE" || {
		logger -t zte-usb-wifi-manager \
			'failed to clear stale device session after credential change'
		return 1
	}
	credential_revision=$_zte_current_credential_revision
}

poll_once() {
	refresh_credential_revision || return 1
	device_identity_invalid=0
	if ! device_profile_still_valid; then
		publish_unsupported_device
		return 1
	fi
	ok=0
	candidate_device_json=''
	health=degraded
	password=''
	fetch_status=0

	if _zte_saved_password=$(zte_read_password "$credential_file" 2>/dev/null); then
		password=$_zte_saved_password
	fi
	_zte_saved_password=''

	# The normalized device schema retains a clients placeholder, but the
	# product never fetches the private collection.
	clients_json=$(zte_adapter_clients_unavailable_json not_loaded) ||
		clients_json='{"available":false,"reason":"not_loaded","items":[]}'
	if raw_json=$(zte_adapter_fetch "$host" "$password" "$COOKIE_FILE"); then
		if candidate_device_json=$(zte_adapter_normalize \
			"$raw_json" "$clients_json"); then
			ok=1
		fi
	else
		fetch_status=$?
	fi
	password=''

	if [ "$fetch_status" = 2 ]; then
		health=credentials_missing
	else
		failure_result=$(zte_failures_next \
			"$failures" "$ok" "$failure_threshold")
		failures=${failure_result%%:*}
		health=${failure_result#*:}
		if [ "$fetch_status" = 3 ]; then
			health=authentication_failed
		fi
	fi
	device_json=$(zte_device_retain \
		"$last_device_json" "$candidate_device_json" "$ok")
	if [ "$ok" = 1 ]; then
		last_device_json=$device_json
	fi

	case $health in
		ok)
			state=ok
			reason=''
			;;
		degraded)
			state=degraded
			reason=device_read_failed
			;;
		fail_safe)
			state=fail_safe
			reason=device_read_threshold_reached
			;;
		credentials_missing)
			state=credentials_missing
			reason=device_credentials_required
			;;
		authentication_failed)
			state=authentication_failed
			reason=device_authentication_failed
			;;
	esac

	collect_network

	# Smart charging changes only U30 Pro's internal power_supply_mode. It never
	# invokes the legacy USB VBUS adapter, so USB networking remains connected.
	policy_state=unavailable
	power_action=keep
	if [ "$ok" = 1 ]; then
		apply_smart_charge_policy
	fi
	if [ "$device_identity_invalid" = 1 ]; then
		publish_unsupported_device
		return 1
	fi
	collect_power_snapshot

	updated=$(date +%s)
	status_json=$(zte_snapshot_compose \
		"$state" "$reason" "$device_json" "$network_json" \
		"$policy_state" "$power_action" "$failures" "$updated" \
		"$power_json" "${ZTE_ADAPTER_MODEL:-U30 Pro}")
	write_status "$status_json"
	record_state_change "$state" "$updated"
}

main() {
	load_config
	init_state
	if ! reset_device_session; then
		logger -t zte-usb-wifi-manager \
			'failed to clear stale device session at startup'
		return 1
	fi
	recover_charging_transaction
	if ! configure_device_profile; then
		publish_unsupported_device
		logger -t zte-usb-wifi-manager 'unsupported USB device profile'
		return 1
	fi
	failures=0
	last_device_json=''
	last_logged_state=''
	smart_charge_retry_after=0
	smart_charge_last_error=''
	smart_charge_persistence_failed=0
	_zte_smart_startup_now=$(date +%s)
	if _zte_smart_startup_cooldown=$(zte_smart_charge_cooldown_load \
		"$STATE_DIR" "$_zte_smart_startup_now"); then
		smart_charge_retry_after=${_zte_smart_startup_cooldown%%:*}
		smart_charge_last_error=${_zte_smart_startup_cooldown#*:}
	else
		_zte_smart_startup_status=$?
		if [ "$_zte_smart_startup_status" = 2 ]; then
			smart_charge_persistence_failed=1
		fi
	fi
	credential_revision=$(
		zte_credential_revision "$credential_file" 2>/dev/null
	) || credential_revision=invalid
	shutdown_started=0
	trap shutdown_manager 0
	trap 'exit 0' 1 2 15
	write_pid_file || return 1
	zte_action_reconcile_active "$STATE_DIR" || :
	record_event info service service_started "$(date +%s)" || :
	while [ "$enabled" = 1 ]; do
		poll_once
		sleep "$(zte_backoff_interval "$poll_interval" "$failures")"
	done
}

main "$@"
