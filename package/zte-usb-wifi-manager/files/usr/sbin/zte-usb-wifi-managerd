#!/bin/sh
set -e

. /lib/functions.sh
. /usr/lib/zte-usb-wifi-manager/validation.sh
. /usr/lib/zte-usb-wifi-manager/json.sh
. /usr/lib/zte-usb-wifi-manager/http.sh
. /usr/lib/zte-usb-wifi-manager/credentials.sh
. /usr/lib/zte-usb-wifi-manager/session.sh
. /usr/lib/zte-usb-wifi-manager/policy.sh
. /usr/lib/zte-usb-wifi-manager/schedule.sh
. /usr/lib/zte-usb-wifi-manager/power-adapter.sh
. /usr/lib/zte-usb-wifi-manager/recovery-inhibit.sh
. /usr/lib/zte-usb-wifi-manager/recovery-adapter.sh
. /usr/lib/zte-usb-wifi-manager/event-log.sh
. /usr/lib/zte-usb-wifi-manager/actions.sh
. /usr/lib/zte-usb-wifi-manager/action-executor.sh
. /usr/lib/zte-usb-wifi-manager/snapshot.sh
. /usr/lib/zte-usb-wifi-manager/netifd-adapter.sh
. /usr/lib/zte-usb-wifi-manager/adapter-zte-u25s-metadata.sh
. /usr/lib/zte-usb-wifi-manager/adapter-zte-u25s.sh

STATE_DIR=/var/run/zte-usb-wifi-manager
STATUS_FILE=$STATE_DIR/status.json
COOKIE_FILE=$STATE_DIR/cookies.txt
PID_FILE=$STATE_DIR/manager.pid
EVENT_LOG_MAX_BYTES=524288
ACTION_RESULT_MAX_COUNT=50
PRIVATE_AUTH_BACKOFF_SECONDS=900
RECOVERY_INHIBIT_FILE=$STATE_DIR/inhibit-recovery
RECOVERY_INHIBIT_SECONDS=600
RECOVERY_SERVICE=/etc/init.d/zte-usb-recover
SAFETY_RESTORE_HELPER=/usr/libexec/zte-usb-power-restore

early_safety_restore() {
	[ -x "$SAFETY_RESTORE_HELPER" ] || return 1
	"$SAFETY_RESTORE_HELPER"
}

load_config() {
	# config_get assigns these global variables by the name in its first argument.
	enabled=''
	write_enabled=''
	sim_switch_enabled=''
	cellular_write_enabled=''
	wifi_write_enabled=''
	traffic_write_enabled=''
	sms_write_enabled=''
	poll_interval=''
	failure_threshold=''
	host=''
	interface=''
	netdev=''
	credential_file=''
	battery_enabled=''
	battery_low=''
	battery_high=''
	manual_full=''
	schedule_enabled=''
	schedule_weekdays=''
	schedule_departure=''
	schedule_lead=''
	power_backend=''
	power_control_path=''
	power_calibrated=''
	power_off_probe_interval=''
	power_probe_settle_seconds=''

	config_load zte-usb-wifi-manager
	config_get enabled main enabled 1
	config_get write_enabled main write_enabled 0
	config_get sim_switch_enabled writes sim_switch_enabled 0
	config_get cellular_write_enabled writes cellular_write_enabled 0
	config_get wifi_write_enabled writes wifi_write_enabled 0
	config_get traffic_write_enabled writes traffic_write_enabled 0
	config_get sms_write_enabled writes sms_write_enabled 0
	config_get poll_interval main poll_interval 30
	config_get failure_threshold main failure_threshold 3
	config_get host zte host 192.168.0.1
	config_get interface zte interface usbwan
	config_get netdev zte netdev eth2
	config_get credential_file zte credential_file \
		/etc/zte-usb-wifi-manager/credentials
	config_get battery_enabled policy enabled 0
	config_get battery_low policy low_percent 70
	config_get battery_high policy high_percent 100
	config_get manual_full policy manual_full 0
	config_get schedule_enabled work enabled 0
	config_get schedule_weekdays work weekdays '1 2 3 4 5'
	config_get schedule_departure work departure '18:00'
	config_get schedule_lead work lead_minutes 90
	config_get power_backend usb backend unconfigured
	config_get power_control_path usb control_path \
		auto
	config_get power_calibrated usb calibrated 0
	config_get power_off_probe_interval usb off_probe_interval 900
	config_get power_probe_settle_seconds usb probe_settle_seconds 15

	zte_validate_host "$host" || {
		logger -t zte-usb-wifi-manager 'invalid device host'
		return 1
	}
	zte_validate_interface "$interface" || {
		logger -t zte-usb-wifi-manager 'invalid network interface name'
		return 1
	}
	zte_validate_netdev "$netdev" || {
		logger -t zte-usb-wifi-manager 'invalid network device name'
		return 1
	}
	ZTE_HTTP_INTERFACE=$netdev
	ZTE_POWER_NETDEV_PATH=/sys/class/net/$netdev
	export ZTE_HTTP_INTERFACE ZTE_POWER_NETDEV_PATH
	if ! zte_is_uint "$failure_threshold" ||
		[ "$failure_threshold" -lt 1 ]; then
		logger -t zte-usb-wifi-manager 'invalid failure threshold'
		return 1
	fi
	if ! zte_is_uint "$poll_interval" ||
		[ "$poll_interval" -lt 10 ] ||
		[ "$poll_interval" -gt 3600 ]; then
		logger -t zte-usb-wifi-manager 'invalid poll interval'
		return 1
	fi
	zte_validate_thresholds "$battery_low" "$battery_high" || {
		logger -t zte-usb-wifi-manager 'invalid battery thresholds'
		return 1
	}
	case $enabled:$write_enabled:$sim_switch_enabled:\
$cellular_write_enabled:$wifi_write_enabled:$traffic_write_enabled:\
$sms_write_enabled:$battery_enabled:$manual_full:$schedule_enabled in
		[01]:[01]:[01]:[01]:[01]:[01]:[01]:[01]:[01]:[01]) ;;
		*)
			logger -t zte-usb-wifi-manager 'invalid policy flags'
			return 1
			;;
	esac
	if ! zte_schedule_weekdays_valid "$schedule_weekdays"; then
		logger -t zte-usb-wifi-manager 'invalid charging schedule'
		return 1
	fi
	schedule_departure_minutes=$(
		zte_schedule_time_to_minutes "$schedule_departure"
	) || {
		logger -t zte-usb-wifi-manager 'invalid charging schedule'
		return 1
	}
	if ! zte_schedule_is_uint "$schedule_lead" ||
		[ "$schedule_lead" -lt 1 ] ||
		[ "$schedule_lead" -gt "$schedule_departure_minutes" ]; then
		logger -t zte-usb-wifi-manager 'invalid charging schedule'
		return 1
	fi
	zte_power_backend_valid "$power_backend" || {
		logger -t zte-usb-wifi-manager 'invalid power backend'
		return 1
	}
	zte_power_control_config_valid "$power_control_path" || {
		logger -t zte-usb-wifi-manager 'invalid power control path'
		return 1
	}
	zte_power_calibrated_flag_valid "$power_calibrated" || {
		logger -t zte-usb-wifi-manager 'invalid power calibration flag'
		return 1
	}
	if ! zte_is_uint "$power_off_probe_interval" ||
		[ "$power_off_probe_interval" -lt 60 ] ||
		[ "$power_off_probe_interval" -gt 3600 ]; then
		logger -t zte-usb-wifi-manager 'invalid power-off probe interval'
		return 1
	fi
	if ! zte_is_uint "$power_probe_settle_seconds" ||
		[ "$power_probe_settle_seconds" -lt 1 ] ||
		[ "$power_probe_settle_seconds" -gt 120 ]; then
		logger -t zte-usb-wifi-manager 'invalid power probe settle time'
		return 1
	fi
}

configured_action_enabled() {
	_zte_configured_action=$1
	case $_zte_configured_action in
		switch_sim) _zte_configured_feature=$sim_switch_enabled ;;
		set_apn|set_connection_mode)
			_zte_configured_feature=$cellular_write_enabled
			;;
		set_wifi) _zte_configured_feature=$wifi_write_enabled ;;
		set_traffic_plan|reset_traffic)
			_zte_configured_feature=$traffic_write_enabled
			;;
		send_sms|delete_sms|mark_sms_read)
			_zte_configured_feature=$sms_write_enabled
			;;
		*) return 1 ;;
	esac
	zte_adapter_action_effectively_enabled \
		"$_zte_configured_action" "$write_enabled" \
		"$_zte_configured_feature"
}

power_inhibit_expiry() {
	_zte_power_expiry_now=$1
	zte_is_uint "$_zte_power_expiry_now" || return 1
	_zte_power_expiry_horizon=$((
		power_off_probe_interval + power_probe_settle_seconds + 60
	))
	_zte_power_poll_horizon=$((poll_interval + 90))
	if [ "$_zte_power_poll_horizon" -gt \
		"$_zte_power_expiry_horizon" ]; then
		_zte_power_expiry_horizon=$_zte_power_poll_horizon
	fi
	printf '%s\n' \
		"$((_zte_power_expiry_now + _zte_power_expiry_horizon))"
}

schedule_pre_departure_now() {
	_zte_schedule_weekday=$(date +%u)
	_zte_schedule_hour=$(date +%H)
	_zte_schedule_minute=$(date +%M)
	_zte_schedule_now=$(
		zte_schedule_time_to_minutes \
			"$_zte_schedule_hour:$_zte_schedule_minute"
	) || return 1
	zte_schedule_pre_departure \
		"$schedule_enabled" "$schedule_weekdays" \
		"$schedule_departure" "$schedule_lead" \
		"$_zte_schedule_weekday" "$_zte_schedule_now"
}

init_state() {
	umask 077
	mkdir -p "$STATE_DIR"
	chmod 700 "$STATE_DIR"
	zte_event_init "$STATE_DIR"
}

write_pid_file() {
	_zte_pid_dir=${PID_FILE%/*}
	_zte_pid_tmp=$PID_FILE.tmp.$$
	umask 077
	mkdir -p "$_zte_pid_dir" || return 1
	printf '%s\n' "$$" >"$_zte_pid_tmp" || return 1
	chmod 600 "$_zte_pid_tmp" || return 1
	mv "$_zte_pid_tmp" "$PID_FILE"
}

remove_pid_file() {
	[ -s "${PID_FILE:-}" ] || return 0
	_zte_pid_owner=$(cat "$PID_FILE" 2>/dev/null) || return 0
	[ "$_zte_pid_owner" = "$$" ] || return 0
	rm -f "$PID_FILE"
}

write_status() {
	umask 077
	mkdir -p "$STATE_DIR"
	_zte_status_tmp=$STATUS_FILE.tmp.$$
	printf '%s\n' "$1" >"$_zte_status_tmp"
	chmod 600 "$_zte_status_tmp"
	mv "$_zte_status_tmp" "$STATUS_FILE"
}

collect_network() {
	if command -v ubus >/dev/null 2>&1 &&
		command -v jsonfilter >/dev/null 2>&1; then
		network_json=$(zte_netifd_collect "$interface" "$netdev")
	else
		network_json=$(zte_netifd_json 0 "$netdev" '' '' 0)
	fi
}

collect_power_snapshot() {
	_zte_power_snapshot_board=''
	_zte_power_snapshot_path=''
	_zte_power_snapshot_control=''
	_zte_power_snapshot_supply=''
	case $power_backend in
		dry-run|hardware)
			_zte_power_snapshot_board=$(zte_power_detect_board 2>/dev/null) ||
				_zte_power_snapshot_board=''
			if [ -n "$_zte_power_snapshot_board" ]; then
				_zte_power_snapshot_path=$(zte_power_resolve_control_path \
					"$_zte_power_snapshot_board" "$power_control_path" \
					2>/dev/null) || _zte_power_snapshot_path=''
			fi
			if [ -n "$_zte_power_snapshot_path" ]; then
				_zte_power_snapshot_control=$(zte_power_hardware_read \
					"$_zte_power_snapshot_path" 2>/dev/null) ||
					_zte_power_snapshot_control=''
				_zte_power_snapshot_supply=$(zte_power_supply_read \
					"$_zte_power_snapshot_path" 2>/dev/null) ||
					_zte_power_snapshot_supply=''
			fi
			;;
	esac
	_zte_power_snapshot_decision=''
	if [ -s "$STATE_DIR/power-decision.json" ]; then
		_zte_power_snapshot_decision=$(cat \
			"$STATE_DIR/power-decision.json" 2>/dev/null) ||
			_zte_power_snapshot_decision=''
	fi
	_zte_power_snapshot_now=$(date +%s)
	_zte_power_snapshot_inhibited=0
	if zte_recovery_inhibit_active \
		"$RECOVERY_INHIBIT_FILE" "$_zte_power_snapshot_now"; then
		_zte_power_snapshot_inhibited=1
	fi
	_zte_power_snapshot_available=0
	_zte_power_snapshot_recovery=0
	if zte_recovery_service_available "$RECOVERY_SERVICE"; then
		_zte_power_snapshot_available=1
	fi
	if [ "$_zte_power_snapshot_available" = 1 ] &&
		zte_recovery_service_running "$RECOVERY_SERVICE"; then
		_zte_power_snapshot_recovery=1
	fi
	_zte_power_snapshot_execution=0
	case $power_backend in
		unconfigured)
			_zte_power_snapshot_execution_reason=backend_unconfigured
			;;
		mock)
			_zte_power_snapshot_execution=1
			_zte_power_snapshot_execution_reason=mock
			;;
		dry-run)
			_zte_power_snapshot_execution=1
			_zte_power_snapshot_execution_reason=dry_run
			;;
		hardware)
			if [ "$write_enabled" != 1 ]; then
				_zte_power_snapshot_execution_reason=write_disabled
			elif [ "$power_calibrated" != 1 ]; then
				_zte_power_snapshot_execution_reason=not_calibrated
			elif [ -z "$_zte_power_snapshot_board" ]; then
				_zte_power_snapshot_execution_reason=board_unsupported
			elif [ -z "$_zte_power_snapshot_path" ]; then
				_zte_power_snapshot_execution_reason=control_unresolved
			elif [ "$_zte_power_snapshot_available" != 1 ]; then
				_zte_power_snapshot_execution_reason=recovery_unavailable
			else
				_zte_power_snapshot_execution=1
				_zte_power_snapshot_execution_reason=ready
			fi
			;;
	esac
	_zte_power_snapshot_profile=$(zte_power_profile_id \
		"$power_backend" "$power_calibrated" "$write_enabled" \
		"$_zte_power_snapshot_board" "$_zte_power_snapshot_path") ||
		_zte_power_snapshot_profile=''
	if [ -n "$_zte_power_snapshot_decision" ]; then
		_zte_power_snapshot_decision=$(zte_power_decision_current_json \
			"$_zte_power_snapshot_decision" \
			"$_zte_power_snapshot_profile" 2>/dev/null) ||
			_zte_power_snapshot_decision=''
	fi
	power_json=$(zte_power_snapshot_json \
		"$power_backend" "$power_calibrated" "$write_enabled" \
		"$_zte_power_snapshot_path" "$_zte_power_snapshot_control" \
		"$_zte_power_snapshot_supply" "$_zte_power_snapshot_decision" \
		"$_zte_power_snapshot_inhibited" "$_zte_power_snapshot_available" \
		"$_zte_power_snapshot_recovery" \
		"$_zte_power_snapshot_execution" \
		"$_zte_power_snapshot_execution_reason")
}

zte_power_detect_board() {
	[ -r /tmp/sysinfo/board_name ] || return 1
	_zte_detected_board=$(cat /tmp/sysinfo/board_name) || return 1
	zte_power_board_supported "$_zte_detected_board" || return 1
	printf '%s\n' "$_zte_detected_board"
}

write_power_outcome_record() {
	_zte_power_outcome_backend=$1
	_zte_power_outcome_action=$2
	_zte_power_outcome_executed=$3
	_zte_power_outcome_reason=$4
	_zte_power_outcome_result=$5
	_zte_power_outcome_board=$6
	_zte_power_outcome_path=$7
	_zte_power_outcome_updated=$(date +%s)
	_zte_power_outcome_profile=$(zte_power_profile_id \
		"$_zte_power_outcome_backend" "$power_calibrated" "$write_enabled" \
		"$_zte_power_outcome_board" "$_zte_power_outcome_path") || return 1
	_zte_power_outcome_json=$(printf \
		'{"backend":"%s","action":"%s","executed":%s,"reason":"%s","outcome":"%s","updated":%s,"profile":"%s"}' \
		"$_zte_power_outcome_backend" "$_zte_power_outcome_action" \
		"$_zte_power_outcome_executed" "$_zte_power_outcome_reason" \
		"$_zte_power_outcome_result" "$_zte_power_outcome_updated" \
		"$(zte_json_escape "$_zte_power_outcome_profile")")
	if ! zte_power_write_record \
		"$STATE_DIR/power-decision.json" "$_zte_power_outcome_json"; then
		rm -f "$STATE_DIR/power-decision.json"
		return 1
	fi
}

apply_policy_action() {
	_zte_policy_state=$1
	_zte_policy_action=$2
	case $_zte_policy_state in
		MAINTAIN_CHARGING) _zte_power_reason=battery_low ;;
		MAINTAIN_BATTERY) _zte_power_reason=battery_high ;;
		MANUAL_FULL) _zte_power_reason=manual_full ;;
		PRE_DEPARTURE) _zte_power_reason=pre_departure ;;
		FAIL_SAFE_ON) _zte_power_reason=fail_safe ;;
		*) return 0 ;;
	esac

	_zte_power_board=''
	_zte_power_effective_control_path=${power_control_path-}
	case $power_backend in
		mock)
			_zte_power_effective_control_path=''
			;;
		dry-run)
			_zte_power_board=$(zte_power_detect_board 2>/dev/null) ||
				_zte_power_board=''
			if [ -n "$_zte_power_board" ]; then
				_zte_power_effective_control_path=$(
					zte_power_resolve_control_path \
						"$_zte_power_board" "$power_control_path" \
						2>/dev/null
				) || _zte_power_effective_control_path=''
			else
				_zte_power_effective_control_path=''
			fi
			;;
		hardware)
			[ "$write_enabled" = 1 ] || return 0
			[ "$power_calibrated" = 1 ] || return 0
			_zte_power_board=$(zte_power_detect_board) || {
				logger -t zte-usb-wifi-manager \
					'unsupported or unreadable power-control board'
				return 0
			}
			_zte_power_effective_control_path=$(
				zte_power_resolve_control_path \
					"$_zte_power_board" "$power_control_path"
			) || {
				logger -t zte-usb-wifi-manager \
					'power-control profile does not match board'
				return 0
			}
			zte_recovery_service_available "$RECOVERY_SERVICE" || {
				write_power_outcome_record \
					hardware "$_zte_policy_action" false \
					"$_zte_power_reason" failed "$_zte_power_board" \
					"$_zte_power_effective_control_path" || :
				logger -t zte-usb-wifi-manager \
					'USB recovery service unavailable'
				return 0
			}
			;;
		*) return 0 ;;
	esac
	[ "$_zte_policy_action" != KEEP ] || return 0
	[ "$_zte_policy_action" != "$last_power_action" ] || return 0
	if [ "$power_backend" = hardware ] &&
		[ "$_zte_policy_action" = OFF ]; then
		_zte_power_is_default=$(
			zte_json_top_get "$network_json" is_default_route 2>/dev/null
		) || _zte_power_is_default=''
		[ "$_zte_power_is_default" = false ] || {
			logger -t zte-usb-wifi-manager \
				'power-off deferred while U25S is the default route'
			return 0
		}
	fi
	if [ "$_zte_policy_action" = OFF ] &&
		[ "$power_backend" = mock ] &&
		zte_action_has_active "$STATE_DIR"; then
		logger -t zte-usb-wifi-manager \
			'power-off deferred while a device action is active'
		return 0
	fi

	_zte_power_inhibit_written=0
	_zte_power_transition_claimed=0
	if { [ "$power_backend" = mock ] ||
		[ "$power_backend" = hardware ]; } &&
		[ "$_zte_policy_action" = OFF ]; then
		if [ "$power_backend" = hardware ]; then
			zte_power_transition_claim "$STATE_DIR" || {
				logger -t zte-usb-wifi-manager \
					'power-off deferred by device-action lock'
				return 0
			}
			_zte_power_transition_claimed=1
		fi
		_zte_power_now=$(date +%s)
		if [ "$power_backend" = hardware ]; then
			_zte_power_expires=$(
				power_inhibit_expiry "$_zte_power_now"
			) || {
				zte_power_transition_release "$STATE_DIR" || :
				write_power_outcome_record \
					hardware "$_zte_policy_action" false \
					"$_zte_power_reason" failed "$_zte_power_board" \
					"$_zte_power_effective_control_path" || :
				return 1
			}
		else
			_zte_power_expires=$((_zte_power_now + RECOVERY_INHIBIT_SECONDS))
		fi
		if [ "$power_backend" = hardware ]; then
			zte_recovery_prepare_off \
				"$RECOVERY_INHIBIT_FILE" battery_high \
				"$_zte_power_expires" "$_zte_power_now" \
				"$RECOVERY_SERVICE" || {
				zte_power_transition_release "$STATE_DIR" || :
				write_power_outcome_record \
					hardware "$_zte_policy_action" false \
					"$_zte_power_reason" failed "$_zte_power_board" \
					"$_zte_power_effective_control_path" || :
				return 1
			}
		else
			zte_recovery_inhibit_write \
				"$RECOVERY_INHIBIT_FILE" battery_high \
				"$_zte_power_expires" "$_zte_power_now" ||
				{
					write_power_outcome_record \
						"$power_backend" "$_zte_policy_action" false \
						"$_zte_power_reason" failed "$_zte_power_board" \
						"$_zte_power_effective_control_path" || :
					return 1
				}
		fi
		_zte_power_inhibit_written=1
	fi

	_zte_power_decision_updated=$(date +%s)
	_zte_power_apply_completed=0
	_zte_power_audit_retry_failed=0
	_zte_power_apply_result=''
	if _zte_power_apply_result=$(zte_power_apply \
		"$power_backend" "$_zte_policy_action" "$_zte_power_reason" \
		"$STATE_DIR/power-decision.json" \
		"$_zte_power_effective_control_path" \
		"$power_calibrated" "$_zte_power_board" \
		"$write_enabled" "$_zte_power_decision_updated"); then
		_zte_power_apply_completed=1
	else
		_zte_power_apply_status=$?
		if [ "$_zte_power_apply_status" = 2 ]; then
			_zte_power_expected_profile=$(zte_power_profile_id \
				"$power_backend" "$power_calibrated" "$write_enabled" \
				"$_zte_power_board" \
				"$_zte_power_effective_control_path") ||
				_zte_power_expected_profile=''
			if zte_power_decision_current_json \
				"$_zte_power_apply_result" \
				"$_zte_power_expected_profile" >/dev/null 2>&1; then
				_zte_power_apply_completed=1
				logger -t zte-usb-wifi-manager \
					'power action succeeded but initial audit write failed'
				zte_power_write_record \
					"$STATE_DIR/power-decision.json" \
					"$_zte_power_apply_result" ||
					_zte_power_audit_retry_failed=1
			fi
		fi
	fi
	if [ "$_zte_power_apply_completed" = 1 ]; then
		if [ "$_zte_policy_action" = ON ]; then
			case $power_backend in
				hardware)
					zte_recovery_finish_on \
						"$RECOVERY_INHIBIT_FILE" \
						"$RECOVERY_SERVICE" || {
						logger -t zte-usb-wifi-manager \
							'USB recovery service restart failed'
						write_power_outcome_record \
							hardware "$_zte_policy_action" true \
							"$_zte_power_reason" failed \
							"$_zte_power_board" \
							"$_zte_power_effective_control_path" || :
						return 1
					}
					;;
				mock)
					zte_recovery_inhibit_clear \
						"$RECOVERY_INHIBIT_FILE" || :
					;;
			esac
		fi
		last_power_action=$_zte_policy_action
		if [ "$power_backend" = hardware ]; then
			case $_zte_policy_action in
				OFF)
					planned_power_off=1
					_zte_power_off_started=$(date +%s)
					next_power_probe_at=$((_zte_power_off_started +
						power_off_probe_interval))
					;;
				ON)
					planned_power_off=0
					next_power_probe_at=0
					zte_power_transition_release "$STATE_DIR" || :
					;;
			esac
		fi
		if [ "$_zte_power_audit_retry_failed" = 1 ]; then
			rm -f "$STATE_DIR/power-decision.json"
			logger -t zte-usb-wifi-manager \
				'power audit retry failed; stale decision cleared'
			return 1
		fi
	else
		if [ "$_zte_power_inhibit_written" = 1 ] &&
			[ "$power_backend" != hardware ]; then
			zte_recovery_inhibit_clear "$RECOVERY_INHIBIT_FILE" || :
		fi
		write_power_outcome_record \
			"$power_backend" "$_zte_policy_action" false \
			"$_zte_power_reason" failed "$_zte_power_board" \
			"$_zte_power_effective_control_path" || :
		logger -t zte-usb-wifi-manager 'power action or verification failed'
		if [ "$power_backend" = hardware ] &&
			[ "$_zte_policy_action" = OFF ] &&
			[ "$_zte_power_transition_claimed" = 1 ]; then
			planned_power_off=1
			next_power_probe_at=$((
				$(date +%s) + power_probe_settle_seconds
			))
		fi
		return 1
	fi
}

restore_power_on() {
	_zte_restore_transition=0
	if zte_power_transition_active "$STATE_DIR"; then
		_zte_restore_transition=1
	fi
	if ! { [ "$power_backend" = hardware ] &&
		[ "$power_calibrated" = 1 ]; } &&
		[ "$_zte_restore_transition" = 0 ]; then
		return 0
	fi
	_zte_restore_board=$(zte_power_detect_board) || return 1
	_zte_restore_control_path=$(
		zte_power_resolve_control_path \
			"$_zte_restore_board" "$power_control_path"
	) || return 1
	if ! zte_power_hardware_apply ON "$_zte_restore_control_path"; then
		write_power_outcome_record \
			hardware ON false disabled failed "$_zte_restore_board" \
			"$_zte_restore_control_path" || :
		return 1
	fi
	write_power_outcome_record \
		hardware ON true disabled succeeded "$_zte_restore_board" \
		"$_zte_restore_control_path" || {
		logger -t zte-usb-wifi-manager \
			'USB power restored but audit record failed'
	}
	if [ -s "$RECOVERY_INHIBIT_FILE" ]; then
		zte_recovery_finish_on \
			"$RECOVERY_INHIBIT_FILE" "$RECOVERY_SERVICE" || {
			write_power_outcome_record \
				hardware ON true disabled failed "$_zte_restore_board" \
				"$_zte_restore_control_path" || :
			return 1
		}
	elif [ "$_zte_restore_transition" = 1 ] &&
		! zte_recovery_service_running "$RECOVERY_SERVICE"; then
		zte_recovery_service_control "$RECOVERY_SERVICE" start ||
			{
				write_power_outcome_record \
					hardware ON true disabled failed "$_zte_restore_board" \
					"$_zte_restore_control_path" || :
				return 1
			}
		zte_recovery_service_running "$RECOVERY_SERVICE" || {
			write_power_outcome_record \
				hardware ON true disabled failed "$_zte_restore_board" \
				"$_zte_restore_control_path" || :
			return 1
		}
	fi
	last_power_action=ON
	planned_power_off=0
	next_power_probe_at=0
	if [ "$_zte_restore_transition" = 1 ]; then
		zte_power_transition_release "$STATE_DIR" || :
	fi
}

shutdown_manager() {
	[ "${shutdown_started:-0}" = 0 ] || return 0
	shutdown_started=1
	trap - 0 1 2 15
	set +e
	restore_power_on || {
		logger -t zte-usb-wifi-manager \
			'failed to restore USB power during shutdown'
	}
	remove_pid_file
}

record_event() {
	_zte_event_level=$1
	_zte_event_type=$2
	_zte_event_code=$3
	_zte_event_time=$4
	zte_event_write \
		"$STATE_DIR" "$_zte_event_level" "$_zte_event_type" \
		"$_zte_event_code" "$_zte_event_time" "$EVENT_LOG_MAX_BYTES"
}

record_state_change() {
	_zte_new_state=$1
	_zte_state_time=$2
	[ "$_zte_new_state" != "$last_logged_state" ] || return 0

	case $_zte_new_state in
		ok|planned_off) _zte_state_level=info ;;
		degraded|credentials_missing|authentication_failed) _zte_state_level=warn ;;
		fail_safe) _zte_state_level=error ;;
		*) return 0 ;;
	esac
	if record_event \
		"$_zte_state_level" state "state_$_zte_new_state" \
		"$_zte_state_time"; then
		last_logged_state=$_zte_new_state
	fi
}

process_actions() {
	_zte_action_record=$(zte_action_claim "$STATE_DIR" 2>/dev/null) ||
		return 0
	_zte_operation_id=$(zte_json_top_get "$_zte_action_record" operation_id)
	_zte_action_type=$(zte_json_top_get "$_zte_action_record" type)
	if ! zte_operation_id_valid "$_zte_operation_id" ||
		! zte_action_type_valid "$_zte_action_type"; then
		logger -t zte-usb-wifi-manager 'invalid queued action record'
		return 1
	fi
	_zte_action_time=$(date +%s)
	_zte_action_state=failed
	_zte_action_code=unsupported
	_zte_action_event_level=warn
	_zte_action_event_code=action_unsupported

	if zte_adapter_action_supported "$_zte_action_type" &&
		! configured_action_enabled "$_zte_action_type"; then
		_zte_action_code=write_not_enabled
		_zte_action_event_level=error
		_zte_action_event_code=action_failed
	elif zte_adapter_action_supported "$_zte_action_type"; then
		case $_zte_action_type in
			switch_sim)
				_zte_action_target=$(
					zte_json_path_get \
						"$_zte_action_record" payload target
				)
				_zte_action_password=''
				_zte_action_login_required=0
				if zte_adapter_login_required; then
					_zte_action_login_required=1
					if _zte_saved_action_password=$(
						zte_read_password \
							"$credential_file" 2>/dev/null
					); then
						_zte_action_password=$_zte_saved_action_password
					fi
				fi
				_zte_saved_action_password=''
				if [ "$_zte_action_login_required" = 1 ] &&
					[ -z "$_zte_action_password" ]; then
					_zte_action_code=credentials_missing
					_zte_action_event_level=error
					_zte_action_event_code=action_failed
				else
					_zte_action_result=''
					if _zte_action_result=$(
						zte_execute_switch_sim \
							"$host" "$_zte_action_password" \
							"$COOKIE_FILE" "$_zte_action_target"
					); then
						_zte_action_state=succeeded
						_zte_action_code=ok
						_zte_action_event_level=info
						_zte_action_event_code=action_succeeded
					else
						if zte_action_code_valid \
							"$_zte_action_result"; then
							_zte_action_code=$_zte_action_result
						else
							_zte_action_code=executor_failed
						fi
						_zte_action_event_level=error
						_zte_action_event_code=action_failed
					fi
				fi
				_zte_action_password=''
				_zte_action_login_required=0
				;;
		esac
	fi

	zte_action_finish \
		"$STATE_DIR" "$_zte_operation_id" "$_zte_action_state" \
		"$_zte_action_code" "$_zte_action_time" || return 1
	zte_action_prune_results \
		"$STATE_DIR" "$ACTION_RESULT_MAX_COUNT" || return 1
	record_event \
		"$_zte_action_event_level" action "$_zte_action_event_code" \
		"$_zte_action_time" || :
}

read_current_power_state() {
	case $power_backend in
		dry-run) ;;
		hardware)
			if [ "$power_calibrated" != 1 ]; then
				printf '%s\n' UNKNOWN
				return
			fi
			;;
		*)
			printf '%s\n' UNKNOWN
			return
			;;
	esac
	_zte_current_power_board=$(zte_power_detect_board 2>/dev/null) || {
		printf '%s\n' UNKNOWN
		return
	}
	_zte_current_power_path=$(
		zte_power_resolve_control_path \
			"$_zte_current_power_board" "$power_control_path" \
			2>/dev/null
	) || {
		printf '%s\n' UNKNOWN
		return
	}
	zte_power_observed_state "$_zte_current_power_path"
}

calculate_policy() {
	policy_state=unavailable
	power_action=none
	policy_result=''

	case $health in
		fail_safe|credentials_missing)
			policy_result=$(zte_policy_decide \
				"$battery_enabled" 1 0 0 0 \
				"$battery_low" "$battery_high" UNKNOWN) ||
				policy_result=''
			;;
		*)
			if [ "$ok" = 1 ]; then
				battery_percent=$(
					zte_json_path_get "$device_json" battery percent
				)
				current_power=$(read_current_power_state) ||
					current_power=UNKNOWN
				if zte_is_uint "$battery_percent"; then
					pre_departure=0
					pre_departure=$(schedule_pre_departure_now) ||
						pre_departure=0
					policy_result=$(zte_policy_decide \
						"$battery_enabled" 0 "$manual_full" \
						"$pre_departure" "$battery_percent" \
				"$battery_low" "$battery_high" "$current_power") ||
						policy_result=''
				fi
			fi
			;;
	esac

	if [ -n "$policy_result" ]; then
		policy_state=${policy_result%%:*}
		power_action=${policy_result#*:}
		apply_policy_action "$policy_state" "$power_action"
	fi
}

write_power_status() {
	_zte_power_status_state=$1
	_zte_power_status_reason=$2
	_zte_power_status_policy=$3
	_zte_power_status_action=$4
	collect_network
	collect_power_snapshot
	device_json=$last_device_json
	_zte_power_status_updated=$(date +%s)
	_zte_power_status_json=$(zte_snapshot_compose \
		"$_zte_power_status_state" "$_zte_power_status_reason" \
		"$device_json" "$network_json" "$_zte_power_status_policy" \
		"$_zte_power_status_action" "$failures" \
		"$_zte_power_status_updated" "$power_json")
	write_status "$_zte_power_status_json"
	record_state_change \
		"$_zte_power_status_state" "$_zte_power_status_updated"
}

handle_planned_power_off() {
	[ "$planned_power_off" = 1 ] || return 1
	_zte_planned_now=$(date +%s)
	_zte_planned_expires=$(
		power_inhibit_expiry "$_zte_planned_now"
	) || return 1
	if ! zte_recovery_inhibit_renew \
		"$RECOVERY_INHIBIT_FILE" "$_zte_planned_expires" \
		"$_zte_planned_now"; then
		if restore_power_on; then
			sleep "$power_probe_settle_seconds"
			return 1
		fi
		write_power_status \
			fail_safe recovery_inhibit_lost FAIL_SAFE_ON ON
		return 0
	fi
	if [ "$_zte_planned_now" -lt "$next_power_probe_at" ]; then
		failures=0
		write_power_status \
			planned_off battery_high MAINTAIN_BATTERY OFF
		return 0
	fi
	if restore_power_on; then
		sleep "$power_probe_settle_seconds"
		return 1
	fi
	write_power_status \
		fail_safe power_restore_failed FAIL_SAFE_ON ON
	return 0
}

# Populate the private, authenticated collections without turning a partial
# failure into a full device outage. Rejected credentials enter a cooldown so
# a bad saved password cannot trigger the U25S login lockout on every poll.
collect_private_clients() {
	_zte_private_now=$1
	_zte_private_password=$2
	clients_json=$(zte_adapter_clients_unavailable_json not_loaded) || return 1

	if [ -z "$_zte_private_password" ]; then
		clients_json=$(zte_adapter_clients_unavailable_json \
			credentials_missing) || return 1
		return 0
	fi
	if [ "$private_auth_retry_after" -gt "$_zte_private_now" ]; then
		clients_json=$(zte_adapter_clients_unavailable_json \
			authentication_backoff) || return 1
		return 0
	fi

	_zte_private_status=0
	if _zte_private_clients=$(zte_adapter_fetch_clients \
		"$host" "$_zte_private_password" "$COOKIE_FILE"); then
		clients_json=$_zte_private_clients
		private_auth_retry_after=0
		return 0
	else
		_zte_private_status=$?
	fi
	if [ "$_zte_private_status" = 3 ]; then
		clients_json=$(zte_adapter_clients_unavailable_json \
			authentication_failed) || return 1
		private_auth_retry_after=$((
			_zte_private_now + PRIVATE_AUTH_BACKOFF_SECONDS
		))
	else
		clients_json=$(zte_adapter_clients_unavailable_json read_failed) ||
			return 1
	fi
}

poll_once() {
	if handle_planned_power_off; then
		return 0
	fi
	ok=0
	candidate_device_json=''
	health=degraded
	password=''
	fetch_status=0

	if _zte_saved_password=$(zte_read_password "$credential_file" 2>/dev/null); then
		password=$_zte_saved_password
	fi
	_zte_saved_password=''

	if raw_json=$(zte_adapter_fetch "$host" "$password" "$COOKIE_FILE"); then
		collect_private_clients "$(date +%s)" "$password"
		if candidate_device_json=$(zte_adapter_normalize \
			"$raw_json" "$clients_json"); then
			ok=1
		fi
	else
		fetch_status=$?
	fi
	password=''

	if [ "$fetch_status" = 2 ]; then
		health=credentials_missing
	else
		failure_result=$(zte_failures_next \
			"$failures" "$ok" "$failure_threshold")
		failures=${failure_result%%:*}
		health=${failure_result#*:}
		if [ "$fetch_status" = 3 ]; then
			health=authentication_failed
		fi
	fi
	device_json=$(zte_device_retain \
		"$last_device_json" "$candidate_device_json" "$ok")
	if [ "$ok" = 1 ]; then
		last_device_json=$device_json
	fi

	case $health in
		ok)
			state=ok
			reason=''
			;;
		degraded)
			state=degraded
			reason=device_read_failed
			;;
		fail_safe)
			state=fail_safe
			reason=device_read_threshold_reached
			;;
		credentials_missing)
			state=credentials_missing
			reason=device_credentials_required
			;;
		authentication_failed)
			state=authentication_failed
			reason=device_authentication_failed
			;;
	esac

	collect_network

	# Battery data is telemetry only. USB VBUS removal interrupts the U25S data
	# link, so normal polling must never turn the controller off in response to
	# battery level or a schedule. Keep the legacy snapshot fields stable for
	# upgrades while explicitly marking the retired behavior.
	policy_state=retired
	power_action=none
	collect_power_snapshot

	updated=$(date +%s)
	status_json=$(zte_snapshot_compose \
		"$state" "$reason" "$device_json" "$network_json" \
		"$policy_state" "$power_action" "$failures" "$updated" \
		"$power_json")
	write_status "$status_json"
	record_state_change "$state" "$updated"
}

main() {
	early_safety_restore || {
		logger -t zte-usb-wifi-manager \
			'early USB power safety restore failed'
		return 1
	}
	load_config
	init_state
	failures=0
	last_device_json=''
	last_power_action=''
	last_logged_state=''
	private_auth_retry_after=0
	planned_power_off=0
	next_power_probe_at=0
	shutdown_started=0
	trap shutdown_manager 0
	trap 'exit 0' 1 2 15
	write_pid_file || return 1
	zte_recovery_reconcile \
		"$RECOVERY_INHIBIT_FILE" "$(date +%s)" \
		"$RECOVERY_SERVICE" || {
		logger -t zte-usb-wifi-manager \
			'USB recovery reconciliation failed'
	}
	restore_power_on || {
		logger -t zte-usb-wifi-manager \
			'failed to establish safe USB power at startup'
		return 1
	}
	zte_action_reconcile_active "$STATE_DIR" || :
	zte_action_recover_running "$STATE_DIR" "$(date +%s)" || :
	zte_action_prune_results "$STATE_DIR" "$ACTION_RESULT_MAX_COUNT" || :
	record_event info service service_started "$(date +%s)" || :
	while [ "$enabled" = 1 ]; do
		poll_once
		process_actions
		sleep "$(zte_backoff_interval "$poll_interval" "$failures")"
	done
}

main "$@"
