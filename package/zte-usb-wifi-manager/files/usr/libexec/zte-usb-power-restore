#!/bin/sh
set -eu

ZTE_POWER_RESTORE_LIB_DIR=${ZTE_POWER_RESTORE_LIB_DIR:-/usr/lib/zte-usb-wifi-manager}
ZTE_POWER_RESTORE_BOARD_FILE=${ZTE_POWER_RESTORE_BOARD_FILE:-/tmp/sysinfo/board_name}
ZTE_POWER_RESTORE_CONTROL_PATH=${ZTE_POWER_RESTORE_CONTROL_PATH:-}
ZTE_POWER_RESTORE_STATE_DIR=${ZTE_POWER_RESTORE_STATE_DIR:-/var/run/zte-usb-wifi-manager}
ZTE_POWER_RESTORE_INHIBIT_FILE=${ZTE_POWER_RESTORE_INHIBIT_FILE:-$ZTE_POWER_RESTORE_STATE_DIR/inhibit-recovery}
ZTE_POWER_RESTORE_RECOVERY_SERVICE=${ZTE_POWER_RESTORE_RECOVERY_SERVICE:-/etc/init.d/zte-usb-recover}
ZTE_POWER_RESTORE_COORDINATOR_CLAIM=${ZTE_POWER_RESTORE_COORDINATOR_CLAIM:-0}

case $ZTE_POWER_RESTORE_COORDINATOR_CLAIM in
	0|1) ;;
	*) exit 1 ;;
esac

. "$ZTE_POWER_RESTORE_LIB_DIR/validation.sh"
. "$ZTE_POWER_RESTORE_LIB_DIR/json.sh"
. "$ZTE_POWER_RESTORE_LIB_DIR/actions.sh"
. "$ZTE_POWER_RESTORE_LIB_DIR/power-adapter.sh"
. "$ZTE_POWER_RESTORE_LIB_DIR/recovery-inhibit.sh"
. "$ZTE_POWER_RESTORE_LIB_DIR/recovery-adapter.sh"

_zte_restore_transition=0
_zte_restore_power_required=0
_zte_restore_power_confirmed=0
_zte_restore_board=''

if zte_power_transition_active "$ZTE_POWER_RESTORE_STATE_DIR"; then
	_zte_restore_transition=1
	if [ "$ZTE_POWER_RESTORE_COORDINATOR_CLAIM" = 1 ]; then
		trap 'zte_power_transition_release \
"$ZTE_POWER_RESTORE_STATE_DIR" >/dev/null 2>&1 || :' 0
	else
		_zte_restore_power_required=1
	fi
elif [ "$ZTE_POWER_RESTORE_COORDINATOR_CLAIM" = 1 ]; then
	exit 1
fi

if [ -z "$ZTE_POWER_RESTORE_CONTROL_PATH" ]; then
	if [ -r "$ZTE_POWER_RESTORE_BOARD_FILE" ]; then
		_zte_restore_board=$(cat "$ZTE_POWER_RESTORE_BOARD_FILE") || exit 1
	fi
	if zte_power_board_supported "$_zte_restore_board"; then
		ZTE_POWER_RESTORE_CONTROL_PATH=$(
			zte_power_default_control_path "$_zte_restore_board"
		) || exit 1
	elif [ "$_zte_restore_transition" = 1 ] &&
		[ "$ZTE_POWER_RESTORE_COORDINATOR_CLAIM" != 1 ]; then
		exit 1
	fi
fi

if [ -n "$ZTE_POWER_RESTORE_CONTROL_PATH" ] &&
	_zte_restore_value=$(
	zte_power_hardware_read "$ZTE_POWER_RESTORE_CONTROL_PATH" 2>/dev/null
); then
	case $_zte_restore_value in
		0) _zte_restore_power_required=1 ;;
		1) ;;
		*) exit 1 ;;
	esac
	_zte_restore_supply=$(
		zte_power_supply_read "$ZTE_POWER_RESTORE_CONTROL_PATH" 2>/dev/null
	) || exit 1
	case $_zte_restore_supply in
		0|1) ;;
		*) exit 1 ;;
	esac
	if [ "$_zte_restore_value" = 1 ] &&
		[ "$_zte_restore_supply" = 1 ]; then
		_zte_restore_power_confirmed=1
	else
		_zte_restore_power_required=1
	fi
elif [ "$_zte_restore_transition" = 1 ] &&
	[ "$ZTE_POWER_RESTORE_COORDINATOR_CLAIM" != 1 ]; then
	exit 1
fi

if [ "$ZTE_POWER_RESTORE_COORDINATOR_CLAIM" = 1 ] &&
	[ "$_zte_restore_power_required" = 1 ] &&
	[ ! -e "$ZTE_POWER_RESTORE_INHIBIT_FILE" ] &&
	[ ! -L "$ZTE_POWER_RESTORE_INHIBIT_FILE" ]; then
	# Persist recovery responsibility before changing power. This valid but
	# already-expired ownership marker makes the next coordinator poll retry
	# immediately if power restore or recovery restart fails in this process.
	zte_recovery_inhibit_write \
		"$ZTE_POWER_RESTORE_INHIBIT_FILE" manual_power_off 1 0 true ||
		exit 1
fi

if [ "$_zte_restore_power_required" = 1 ]; then
	if [ -z "$_zte_restore_board" ]; then
		[ -r "$ZTE_POWER_RESTORE_BOARD_FILE" ] || exit 1
		_zte_restore_board=$(cat "$ZTE_POWER_RESTORE_BOARD_FILE") || exit 1
	fi
	zte_power_board_supported "$_zte_restore_board" || exit 1
	zte_power_board_control_supported \
		"$_zte_restore_board" "$ZTE_POWER_RESTORE_CONTROL_PATH" || exit 1
	zte_power_hardware_apply ON "$ZTE_POWER_RESTORE_CONTROL_PATH" || exit 1
	[ "$(zte_power_hardware_read "$ZTE_POWER_RESTORE_CONTROL_PATH")" = 1 ] ||
		exit 1
	[ "$(zte_power_supply_read "$ZTE_POWER_RESTORE_CONTROL_PATH")" = 1 ] ||
		exit 1
	_zte_restore_power_confirmed=1
fi

if [ -e "$ZTE_POWER_RESTORE_INHIBIT_FILE" ] ||
	[ -L "$ZTE_POWER_RESTORE_INHIBIT_FILE" ]; then
	if ! zte_recovery_finish_on \
		"$ZTE_POWER_RESTORE_INHIBIT_FILE" \
		"$ZTE_POWER_RESTORE_RECOVERY_SERVICE"; then
		# A missing/corrupt marker cannot prove the previous service state.
		# During an owned transition or after power is confirmed ON, prefer
		# restoring recovery over leaving the modem unprotected.
		if { [ "$_zte_restore_transition" != 1 ] ||
			[ "$ZTE_POWER_RESTORE_COORDINATOR_CLAIM" = 1 ]; } &&
			[ "$_zte_restore_power_confirmed" != 1 ]; then
			exit 1
		fi
		zte_recovery_service_available \
			"$ZTE_POWER_RESTORE_RECOVERY_SERVICE" || exit 1
		zte_recovery_service_control \
			"$ZTE_POWER_RESTORE_RECOVERY_SERVICE" start || exit 1
		zte_recovery_service_running \
			"$ZTE_POWER_RESTORE_RECOVERY_SERVICE" || exit 1
		zte_recovery_inhibit_clear \
			"$ZTE_POWER_RESTORE_INHIBIT_FILE" || exit 1
	fi
elif [ "$_zte_restore_transition" = 1 ] &&
	{ [ "$ZTE_POWER_RESTORE_COORDINATOR_CLAIM" != 1 ] ||
		[ "$_zte_restore_power_required" = 1 ]; } &&
	! zte_recovery_service_running \
		"$ZTE_POWER_RESTORE_RECOVERY_SERVICE"; then
	zte_recovery_service_control \
		"$ZTE_POWER_RESTORE_RECOVERY_SERVICE" start || exit 1
	zte_recovery_service_running \
		"$ZTE_POWER_RESTORE_RECOVERY_SERVICE" || exit 1
fi

if [ "$_zte_restore_transition" = 1 ]; then
	zte_power_transition_release "$ZTE_POWER_RESTORE_STATE_DIR" || exit 1
	[ "$ZTE_POWER_RESTORE_COORDINATOR_CLAIM" != 1 ] || trap - 0
fi
