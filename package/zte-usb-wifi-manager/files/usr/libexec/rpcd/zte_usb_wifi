#!/bin/sh
set -eu

ZTE_USB_WIFI_LIB_DIR=${ZTE_USB_WIFI_LIB_DIR:-/usr/lib/zte-usb-wifi-manager}
. "$ZTE_USB_WIFI_LIB_DIR/validation.sh"
. "$ZTE_USB_WIFI_LIB_DIR/json.sh"
. "$ZTE_USB_WIFI_LIB_DIR/credentials.sh"
. "$ZTE_USB_WIFI_LIB_DIR/actions.sh"
. "$ZTE_USB_WIFI_LIB_DIR/event-log.sh"
. "$ZTE_USB_WIFI_LIB_DIR/charging-transaction.sh"
. "$ZTE_USB_WIFI_LIB_DIR/adapter-zte-u25s-metadata.sh"

STATUS_FILE=${ZTE_USB_WIFI_STATUS_FILE:-/var/run/zte-usb-wifi-manager/status.json}
SMS_FILE=${ZTE_USB_WIFI_SMS_FILE:-/var/run/zte-usb-wifi-manager/sms.json}
STATE_DIR=${ZTE_USB_WIFI_STATE_DIR:-/var/run/zte-usb-wifi-manager}
CREDENTIAL_FILE=${ZTE_USB_WIFI_CREDENTIAL_FILE:-/etc/zte-usb-wifi-manager/credentials}
SERVICE_INIT=${ZTE_USB_WIFI_SERVICE_INIT:-/etc/init.d/zte-usb-wifi-manager}

list_methods() {
	printf '%s\n' \
		'{"status":{},"sms_messages":{},"capabilities":{},"charging_settings":{},"set_charging_settings":{"enabled":"Boolean","low_percent":"Integer","high_percent":"Integer"},"credential_status":{},"set_credentials":{"password":"String"},"clear_credentials":{},"operation_status":{"operation_id":"String"},"logs":{"limit":"Integer"},"cellular_action":{"action":"String","target":"String","confirm":"Boolean","apn":"String","auth":"String","username":"String","password":"String","mode":"String"},"wifi_action":{"action":"String","enabled":"Boolean","band":"String","ssid":"String","security":"String","password":"String","channel":"String"},"traffic_action":{"action":"String","enabled":"Boolean","limit_bytes":"Integer","alert_percent":"Integer","cycle_day":"Integer","disconnect":"Boolean","confirm":"Boolean"},"sms_action":{"action":"String","message_id":"String","number":"String","content":"String","confirm":"Boolean"},"device_action":{"action":"String","confirm":"Boolean"},"power_action":{"action":"String","mode":"String"}}'
}

get_status() {
	if [ -s "$STATUS_FILE" ]; then
		cat "$STATUS_FILE"
	else
		zte_adapter_framework_status_json
	fi
}

get_sms_messages() {
	if [ -s "$SMS_FILE" ]; then
		cat "$SMS_FILE"
	else
		printf '%s\n' \
			'{"available":false,"reason":"not_loaded","items":[]}'
	fi
}

get_credential_status() {
	if _zte_password=$(zte_read_password "$CREDENTIAL_FILE" 2>/dev/null); then
		_zte_password=''
		printf '%s\n' '{"configured":true}'
	else
		printf '%s\n' '{"configured":false}'
	fi
}

apply_cached_profile_from_status() {
	if [ -s "$STATUS_FILE" ]; then
		_zte_profile_status=$(cat "$STATUS_FILE" 2>/dev/null) || return 1
		if [ -n "$_zte_profile_status" ]; then
			_zte_profile_cached_adapter=$(zte_json_path_get \
				"$_zte_profile_status" device adapter 2>/dev/null) ||
				_zte_profile_cached_adapter=''
			_zte_profile_cached_model=$(zte_json_path_get \
				"$_zte_profile_status" device model 2>/dev/null) ||
				_zte_profile_cached_model=''
			zte_adapter_apply_cached_profile \
				"$_zte_profile_cached_adapter" "$_zte_profile_cached_model"
			return
		fi
	fi
	return 1
}

get_capabilities() {
	if ! apply_cached_profile_from_status; then
		zte_adapter_unavailable_capabilities_json
		return
	fi
	_zte_cap_write=$(
		uci -q get zte-usb-wifi-manager.main.write_enabled 2>/dev/null
	) || _zte_cap_write=0
	_zte_cap_switch_sim=$(uci -q get \
		zte-usb-wifi-manager.writes.switch_sim_enabled 2>/dev/null) ||
		_zte_cap_switch_sim=0
	_zte_cap_set_apn=$(uci -q get \
		zte-usb-wifi-manager.writes.set_apn_enabled 2>/dev/null) ||
		_zte_cap_set_apn=0
	_zte_cap_set_connection_mode=$(uci -q get \
		zte-usb-wifi-manager.writes.set_connection_mode_enabled 2>/dev/null) ||
		_zte_cap_set_connection_mode=0
	_zte_cap_set_wifi=$(uci -q get \
		zte-usb-wifi-manager.writes.set_wifi_enabled 2>/dev/null) ||
		_zte_cap_set_wifi=0
	_zte_cap_set_traffic_plan=$(uci -q get \
		zte-usb-wifi-manager.writes.set_traffic_plan_enabled 2>/dev/null) ||
		_zte_cap_set_traffic_plan=0
	_zte_cap_reset_traffic=$(uci -q get \
		zte-usb-wifi-manager.writes.reset_traffic_enabled 2>/dev/null) ||
		_zte_cap_reset_traffic=0
	_zte_cap_send_sms=$(uci -q get \
		zte-usb-wifi-manager.writes.send_sms_enabled 2>/dev/null) ||
		_zte_cap_send_sms=0
	_zte_cap_delete_sms=$(uci -q get \
		zte-usb-wifi-manager.writes.delete_sms_enabled 2>/dev/null) ||
		_zte_cap_delete_sms=0
	_zte_cap_mark_sms_read=$(uci -q get \
		zte-usb-wifi-manager.writes.mark_sms_read_enabled 2>/dev/null) ||
		_zte_cap_mark_sms_read=0
	_zte_cap_reboot_device=$(uci -q get \
		zte-usb-wifi-manager.writes.reboot_device_enabled 2>/dev/null) ||
		_zte_cap_reboot_device=0
	_zte_cap_shutdown_device=$(uci -q get \
		zte-usb-wifi-manager.writes.shutdown_device_enabled 2>/dev/null) ||
		_zte_cap_shutdown_device=0
	_zte_cap_set_power_supply_mode=$(uci -q get \
		zte-usb-wifi-manager.writes.set_power_supply_mode_enabled 2>/dev/null) ||
		_zte_cap_set_power_supply_mode=0
	zte_adapter_effective_capabilities_json \
		"$_zte_cap_write" "$_zte_cap_switch_sim" "$_zte_cap_set_apn" \
		"$_zte_cap_set_connection_mode" "$_zte_cap_set_wifi" \
		"$_zte_cap_set_traffic_plan" "$_zte_cap_reset_traffic" \
		"$_zte_cap_send_sms" "$_zte_cap_delete_sms" \
		"$_zte_cap_mark_sms_read" "$_zte_cap_reboot_device" \
		"$_zte_cap_shutdown_device" "$_zte_cap_set_power_supply_mode"
}

get_charging_settings() {
	_zte_charging_enabled=$(uci -q get \
		zte-usb-wifi-manager.charging.enabled 2>/dev/null) || _zte_charging_enabled=0
	_zte_charging_low=$(uci -q get \
		zte-usb-wifi-manager.charging.low_percent 2>/dev/null) || _zte_charging_low=30
	_zte_charging_high=$(uci -q get \
		zte-usb-wifi-manager.charging.high_percent 2>/dev/null) || _zte_charging_high=80
	case $_zte_charging_enabled in 0|1) ;; *) _zte_charging_enabled=0 ;; esac
	zte_validate_thresholds "$_zte_charging_low" "$_zte_charging_high" || {
		_zte_charging_low=30
		_zte_charging_high=80
	}
	case $_zte_charging_enabled in 1) _zte_charging_enabled_json=true ;; *) _zte_charging_enabled_json=false ;; esac
	printf '{"enabled":%s,"low_percent":%s,"high_percent":%s}\n' \
		"$_zte_charging_enabled_json" "$_zte_charging_low" \
		"$_zte_charging_high"
}

set_charging_settings() {
	_zte_charging_request='{}'
	IFS= read -r _zte_charging_request || :
	if ! zte_json_is_flat_object "$_zte_charging_request" ||
		! zte_adapter_payload_schema "$_zte_charging_request" \
			'enabled low_percent high_percent' \
			'enabled low_percent high_percent'; then
		printf '%s\n' '{"ok":false,"error":"invalid_settings"}'
		return
	fi
	_zte_charging_enabled=$(zte_json_flat_get \
		"$_zte_charging_request" enabled)
	_zte_charging_low=$(zte_json_flat_get \
		"$_zte_charging_request" low_percent)
	_zte_charging_high=$(zte_json_flat_get \
		"$_zte_charging_request" high_percent)
	case $_zte_charging_enabled in
		true) _zte_charging_enabled_raw=1 ;;
		false) _zte_charging_enabled_raw=0 ;;
		*) printf '%s\n' '{"ok":false,"error":"invalid_settings"}'; return ;;
	esac
	if ! zte_validate_thresholds \
		"$_zte_charging_low" "$_zte_charging_high"; then
		printf '%s\n' '{"ok":false,"error":"invalid_settings"}'
		return
	fi
	_zte_charging_result=$(zte_charging_transaction_apply \
		"$STATE_DIR" "$SERVICE_INIT" "$_zte_charging_enabled_raw" \
		"$_zte_charging_low" "$_zte_charging_high")
	if [ "$_zte_charging_result" != ok ]; then
		case $_zte_charging_result in
			transaction_busy|transaction_recovery_failed|settings_snapshot_failed|settings_write_failed|settings_rollback_failed|service_reload_failed|service_restore_failed)
				;;
			*) _zte_charging_result=transaction_recovery_failed ;;
		esac
		printf '{"ok":false,"error":"%s"}\n' "$_zte_charging_result"
		return
	fi
	printf '{"ok":true,"enabled":%s,"low_percent":%s,"high_percent":%s}\n' \
		"$_zte_charging_enabled" "$_zte_charging_low" \
		"$_zte_charging_high"
}

set_credentials() {
	_zte_request='{}'
	IFS= read -r _zte_request || :
	if ! zte_json_is_flat_object "$_zte_request"; then
		printf '%s\n' '{"ok":false,"error":"invalid_password"}'
		return
	fi
	_zte_password=$(zte_json_flat_get "$_zte_request" password)
	if ! zte_password_valid "$_zte_password"; then
		_zte_password=''
		printf '%s\n' '{"ok":false,"error":"invalid_password"}'
		return
	fi
	if ! zte_write_password "$CREDENTIAL_FILE" "$_zte_password"; then
		_zte_password=''
		printf '%s\n' '{"ok":false,"error":"credential_write_failed"}'
		return
	fi
	_zte_password=''
	printf '%s\n' '{"ok":true,"configured":true}'
}

clear_credentials() {
	if ! zte_clear_password "$CREDENTIAL_FILE"; then
		printf '%s\n' '{"ok":false,"error":"credential_clear_failed"}'
		return
	fi
	printf '%s\n' '{"ok":true,"configured":false}'
}

get_logs() {
	_zte_request='{}'
	IFS= read -r _zte_request || :
	if ! zte_json_is_flat_object "$_zte_request"; then
		printf '%s\n' '{"ok":false,"error":"invalid_limit"}'
		return
	fi
	_zte_log_limit=$(zte_json_flat_get "$_zte_request" limit)
	if ! _zte_event_is_uint "$_zte_log_limit" ||
		[ "$_zte_log_limit" -lt 1 ] ||
		[ "$_zte_log_limit" -gt 200 ]; then
		printf '%s\n' '{"ok":false,"error":"invalid_limit"}'
		return
	fi
	zte_event_list "$STATE_DIR" "$_zte_log_limit"
}

get_operation_status() {
	_zte_request='{}'
	IFS= read -r _zte_request || :
	if ! zte_json_is_flat_object "$_zte_request"; then
		printf '%s\n' '{"ok":false,"error":"invalid_operation_id"}'
		return
	fi
	_zte_operation_id=$(zte_json_flat_get "$_zte_request" operation_id)
	if ! zte_operation_id_valid "$_zte_operation_id"; then
		printf '%s\n' '{"ok":false,"error":"invalid_operation_id"}'
		return
	fi
	if ! zte_action_public_status "$STATE_DIR" "$_zte_operation_id"; then
		printf '%s\n' '{"ok":false,"error":"operation_not_found"}'
	fi
}

action_matches_method() {
	case $1:$2 in
		cellular_action:switch_sim|\
cellular_action:set_apn|\
cellular_action:set_connection_mode|\
wifi_action:set_wifi|\
traffic_action:set_traffic_plan|\
traffic_action:reset_traffic|\
sms_action:send_sms|\
sms_action:delete_sms|\
sms_action:mark_sms_read)
			return 0
			;;
		device_action:reboot_device|\
		device_action:shutdown_device)
			return 0
			;;
		power_action:set_power_supply_mode)
			return 0
			;;
		*)
			return 1
			;;
	esac
}

device_writes_enabled() {
	command -v uci >/dev/null 2>&1 || return 1
	_zte_write_enabled=$(
		uci -q get zte-usb-wifi-manager.main.write_enabled 2>/dev/null
	) || return 1
	[ "$_zte_write_enabled" = 1 ]
}

device_action_enabled() {
	_zte_action=$1
	device_writes_enabled || return 1
	_zte_feature_option=$(
		zte_adapter_action_feature_option "$_zte_action"
	) || return 1
	_zte_feature_enabled=$(
		uci -q get \
			"zte-usb-wifi-manager.writes.$_zte_feature_option" \
			2>/dev/null
	) || return 1
	zte_adapter_action_effectively_enabled \
		"$_zte_action" 1 "$_zte_feature_enabled"
}

handle_action() {
	_zte_method=$1
	_zte_request='{}'
	IFS= read -r _zte_request || :
	if ! zte_json_is_flat_object "$_zte_request"; then
		printf '%s\n' '{"ok":false,"error":"invalid_action"}'
		return
	fi
	_zte_action=$(zte_json_flat_get "$_zte_request" action)
	if ! zte_action_type_valid "$_zte_action" ||
		! action_matches_method "$_zte_method" "$_zte_action"; then
		printf '%s\n' '{"ok":false,"error":"invalid_action"}'
		return
	fi
	if ! apply_cached_profile_from_status; then
		printf '%s\n' '{"ok":false,"error":"unsupported"}'
		return
	fi
	if ! zte_adapter_action_supported "$_zte_action"; then
		printf '%s\n' '{"ok":false,"error":"unsupported"}'
		return
	fi
	if ! zte_adapter_action_payload_valid \
		"$_zte_action" "$_zte_request"; then
		printf '%s\n' '{"ok":false,"error":"invalid_action"}'
		return
	fi
	if ! device_action_enabled "$_zte_action"; then
		printf '%s\n' '{"ok":false,"error":"write_not_enabled"}'
		return
	fi
	zte_action_init "$STATE_DIR" || {
		printf '%s\n' '{"ok":false,"error":"queue_unavailable"}'
		return
	}
	if zte_action_has_active "$STATE_DIR"; then
		printf '%s\n' '{"ok":false,"error":"operation_busy"}'
		return
	fi

	_zte_action_created=$(date +%s)
	_zte_operation_id=op-$_zte_action_created-$$
	if ! zte_action_enqueue \
		"$STATE_DIR" "$_zte_operation_id" "$_zte_action" \
		"$_zte_request" "$_zte_action_created"; then
		printf '%s\n' '{"ok":false,"error":"queue_failed"}'
		return
	fi
	printf '{"ok":true,"operation_id":"%s","state":"queued"}\n' \
		"$_zte_operation_id"
}

case ${1-} in
	list)
		list_methods
		;;
	call)
		case ${2-} in
			status) get_status ;;
			sms_messages) get_sms_messages ;;
			capabilities) get_capabilities ;;
			charging_settings) get_charging_settings ;;
			set_charging_settings) set_charging_settings ;;
			credential_status) get_credential_status ;;
			set_credentials) set_credentials ;;
			clear_credentials) clear_credentials ;;
			operation_status) get_operation_status ;;
			logs) get_logs ;;
			cellular_action|wifi_action|traffic_action|sms_action|device_action|power_action)
				handle_action "$2"
				;;
			*) exit 1 ;;
		esac
		;;
	*)
		exit 1
		;;
esac
