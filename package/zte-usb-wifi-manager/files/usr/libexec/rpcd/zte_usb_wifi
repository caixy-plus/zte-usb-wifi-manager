#!/bin/sh
set -eu

ZTE_USB_WIFI_LIB_DIR=${ZTE_USB_WIFI_LIB_DIR:-/usr/lib/zte-usb-wifi-manager}
. "$ZTE_USB_WIFI_LIB_DIR/validation.sh"
. "$ZTE_USB_WIFI_LIB_DIR/json.sh"
. "$ZTE_USB_WIFI_LIB_DIR/actions.sh"
. "$ZTE_USB_WIFI_LIB_DIR/adapter-zte-u25s-metadata.sh"

STATUS_FILE=${ZTE_USB_WIFI_STATUS_FILE:-/var/run/zte-usb-wifi-manager/status.json}
STATE_DIR=${ZTE_USB_WIFI_STATE_DIR:-/var/run/zte-usb-wifi-manager}

list_methods() {
	printf '%s\n' \
		'{"status":{},"capabilities":{},"operation_status":{"operation_id":"String"}}'
}

get_status() {
	if [ -s "$STATUS_FILE" ]; then
		cat "$STATUS_FILE"
	else
		zte_adapter_framework_status_json
	fi
}

get_operation_status() {
	_zte_request='{}'
	IFS= read -r _zte_request || :
	if ! zte_json_is_flat_object "$_zte_request"; then
		printf '%s\n' '{"ok":false,"error":"invalid_operation_id"}'
		return
	fi
	_zte_operation_id=$(zte_json_flat_get "$_zte_request" operation_id)
	if ! zte_operation_id_valid "$_zte_operation_id"; then
		printf '%s\n' '{"ok":false,"error":"invalid_operation_id"}'
		return
	fi
	if ! zte_action_get "$STATE_DIR" "$_zte_operation_id"; then
		printf '%s\n' '{"ok":false,"error":"operation_not_found"}'
	fi
}

case ${1-} in
	list)
		list_methods
		;;
	call)
		case ${2-} in
			status) get_status ;;
			capabilities) zte_adapter_capabilities_json ;;
			operation_status) get_operation_status ;;
			*) exit 1 ;;
		esac
		;;
	*)
		exit 1
		;;
esac
