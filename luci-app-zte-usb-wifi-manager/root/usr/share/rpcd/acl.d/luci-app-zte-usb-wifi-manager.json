{
  "luci-app-zte-usb-wifi-manager": {
    "description": "Read ZTE USB WiFi Manager status",
    "read": {
      "ubus": {
        "zte_usb_wifi": [
          "status",
          "capabilities",
          "operation_status",
          "logs"
        ]
      }
    },
    "write": {
      "ubus": {
        "zte_usb_wifi": [
          "cellular_action",
          "wifi_action",
          "traffic_action",
          "sms_action"
        ]
      }
    }
  }
}
